#!/usr/bin/env bash
# Pre-commit guardrail. Tracked in the repo rather than living in .git/hooks, so
# a fresh clone gets it. Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Five layers, each paid for once (docs/why.md in the kit). The bypass is the
# no-verify flag on the commit: the Claude Code command guard refuses it, and a
# human should expect to explain it.
set -uo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# ─────────────────────────────────────────────────────────────────────
# Layer 1 — paths that must never enter history.
#
# .gitignore alone is not enough: `git add -f` walks straight past it, and a
# bulk `git add -A` sweeps in anything not yet ignored. Add a pattern here for
# every directory holding runtime uploads, client material, licensed documents,
# large binaries or scratch work.
# ─────────────────────────────────────────────────────────────────────
FORBIDDEN_PATHS=(
  '^uploads/'
  '^\.env$'
  '^\.env\..*'
  '^ops/\.env\..*'
  '^.*\.pem$'
  '^.*\.key$'
  '^.*\.pid$'
  '^.*-nohup\.log$'
  # '^client-data/'
  # '^design-mockups/'
)

VIOLATIONS=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  for pattern in "${FORBIDDEN_PATHS[@]}"; do
    if [[ "$path" =~ $pattern ]]; then
      VIOLATIONS+=("  $path  (matched: $pattern)")
      break
    fi
  done
done <<< "$STAGED"

if [ ${#VIOLATIONS[@]} -ne 0 ]; then
  echo
  echo "pre-commit blocked: staged paths in never-track directories"
  echo
  printf '%s\n' "${VIOLATIONS[@]}"
  echo
  echo "Likely cause: 'git add -A' / 'git add .' — use explicit file paths instead."
  echo
  echo "To recover:"
  echo "  git reset HEAD <paths-you-actually-meant>"
  echo
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────
# Layer 2 — .editorconfig compliance, staged files only.
#
# Checking the whole tree fails on every pre-existing violation and gets
# disabled within a week. Checking only what this commit touches is the version
# people keep.
# ─────────────────────────────────────────────────────────────────────
CHECKER=""
for candidate in node_modules/.bin/editorconfig-checker ./bin/editorconfig-checker; do
  [ -x "$candidate" ] && CHECKER="$candidate" && break
done

if [ -n "$CHECKER" ]; then
  if ! git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r "$CHECKER"; then
    echo
    echo "pre-commit blocked: .editorconfig violation on a staged file"
    echo
    echo "A file you just changed has trailing whitespace, the wrong indent,"
    echo "the wrong line endings, or no final newline."
    echo
    echo "Auto-fix:  npx editorconfig-checker --fix <path>"
    echo
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────
# Layer 3 — the project's own check.
#
# Put the check that would have caught your worst bug here, scoped to the files
# this commit touches. The project this kit came from greps new lines in route
# files for a tenant filter that silently drops when its variable is undefined,
# which is how two cross-tenant leaks shipped on the same day.
# ─────────────────────────────────────────────────────────────────────
if [ -x "scripts/pre-commit-check.sh" ]; then
  # shellcheck disable=SC2086
  scripts/pre-commit-check.sh $STAGED || exit 1
fi

# ─────────────────────────────────────────────────────────────────────
# Layer 4 — ESLint on staged source files only.
#
# A broken `npm run lint` went unnoticed for a month because nobody ran it.
# Linting just the files this commit touches catches new violations without
# gating on the old ones. Errors block; warnings print and pass.
# ─────────────────────────────────────────────────────────────────────
ESLINT_DIR="."   # the package that holds eslint and its config: `.` or `frontend`
if [ -x "$ESLINT_DIR/node_modules/.bin/eslint" ]; then
  prefix="${ESLINT_DIR#.}"; prefix="${prefix#/}"; [ -n "$prefix" ] && prefix="$prefix/"
  STAGED_SRC=$(printf '%s\n' "$STAGED" | grep -E "^${prefix}src/.*\.(js|jsx|ts|tsx)$" | sed "s|^${prefix}||" || true)
  if [ -n "$STAGED_SRC" ]; then
    # shellcheck disable=SC2086
    if ! (cd "$ESLINT_DIR" && node_modules/.bin/eslint $STAGED_SRC); then
      echo
      echo "pre-commit blocked: ESLint errors in a staged source file"
      echo
      echo "Only the files in this commit were linted. Auto-fixable rules:"
      echo "  (cd $ESLINT_DIR && npx eslint --fix <path>)"
      echo
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────
# Layer 5 — rule gates. The CLAUDE.md rules a script can check, one per
# incident, in scripts/check-rules.mjs. Added lines only, except the rules that
# say "touching the file means fixing it". An owner-approved exception carries
# `gate-ok: <rule-id> <reason>` on the line and is counted in the daily report.
# ─────────────────────────────────────────────────────────────────────
if [ -f "scripts/check-rules.mjs" ]; then
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r node scripts/check-rules.mjs || exit 1
fi

exit 0
