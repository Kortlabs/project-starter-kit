#!/usr/bin/env bash
# Block non-fast-forward (force) pushes to the default branch and its deletion:
# the only git operations here that are hard to undo. Normal pushes and other
# branches are untouched. A deliberate history rewrite bypasses with the
# no-verify flag on the push, which the Claude Code command guard refuses.
PROTECTED="refs/heads/main"
remote_name="$1"
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$PROTECTED" ] || continue
  [ "$remote_sha" = "$zero" ] && continue          # first push of the branch
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push blocked: attempting to DELETE $PROTECTED on '$remote_name'." >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push blocked: non-fast-forward push to $PROTECTED (history rewrite)." >&2
    echo "   Remote ($remote_sha) is not an ancestor of what you are pushing." >&2
    exit 1
  fi
done
exit 0
